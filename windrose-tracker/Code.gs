/* ------------------------------------------------------------------ */
function onOpen() {
  SpreadsheetApp.getUi().createMenu('🧭 Windrose')
    .addItem('Build / Rebuild tracker', 'buildWindroseTracker')
    .addToUi();
}

function buildWindroseTracker() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  TABS.forEach(function (t) { buildTab_(ss, t); });  // tabs first, so Dashboard cross-sheet formulas resolve
  buildDashboard_(ss);
  buildHowTo_(ss);
  const order = ['Dashboard'].concat(TABS.map(function (t) { return t.name; })).concat(['How to use']);
  orderSheets_(ss, order);
  removeDefault_(ss);
  ss.setActiveSheet(ss.getSheetByName('Dashboard'));
  ss.toast(DATA.length + ' items across ' + TABS.length + ' category tabs. Tick the gear tabs & Share!',
           '🧭 Windrose ready', 6);
}

/* ---- helpers ---- */
function colLetter_(n) {
  let s = '';
  while (n > 0) { const m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = (n - m - 1) / 26; }
  return s;
}
function cap_(s) { s = String(s || ''); return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }

function matchTab_(d, tab) {
  if (tab.types) return tab.types.indexOf(d.type) >= 0;
  if (tab.category) return d.category === tab.category;
  return false;
}

function freshSheet_(ss, name) {
  let sh = ss.getSheetByName(name);
  if (sh) {
    const f = sh.getFilter(); if (f) f.remove();
    sh.getBandings().forEach(function (b) { b.remove(); });
    sh.clearConditionalFormatRules();
    sh.clear();
    if (sh.getMaxRows() > 1) sh.setRowHeights(1, sh.getMaxRows(), 21);
  } else {
    sh = ss.insertSheet(name);
  }
  return sh;
}

function orderSheets_(ss, order) {
  order.forEach(function (name, i) {
    const s = ss.getSheetByName(name);
    if (s) { ss.setActiveSheet(s); ss.moveActiveSheet(i + 1); }
  });
}

function removeDefault_(ss) {
  // blank default sheet
  ['Sheet1', 'Sheet 1'].forEach(function (n) {
    const s = ss.getSheetByName(n);
    if (s && s.getLastRow() === 0 && ss.getSheets().length > 1) {
      try { ss.deleteSheet(s); } catch (e) {}
    }
  });
  // legacy single-tab "Recipes" sheet from an earlier version (now split into category tabs)
  const old = ss.getSheetByName('Recipes');
  if (old && ss.getSheets().length > 1) { try { ss.deleteSheet(old); } catch (e) {} }
}

/* ---- a category tab ---- */
function buildTab_(ss, tab) {
  const keep = tab.track ? snapshotTicks_(ss, tab.name) : null;   // preserve crew ticks across rebuilds
  const sh = freshSheet_(ss, tab.name);
  const track = !!tab.track;
  const HEAD = track ? T_HEAD : R_HEAD;
  const nCols = HEAD.length;
  const merchantCol = track ? 8 : 7;

  sh.getRange(1, 1, 1, nCols).setValues([HEAD])
    .setFontWeight('bold').setFontColor('#ffffff').setBackground(HEADER_BG)
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
  sh.setRowHeight(1, 36);

  const recs = DATA.filter(function (d) { return matchTab_(d, tab); });
  const nRows = recs.length;
  sh.setTabColor(tab.color);
  if (nRows === 0) return;

  const rows = recs.map(function (d, i) {
    const r = i + 2;
    const icon = d.imageUrl ? '=IMAGE("' + d.imageUrl + '",4,36,36)' : '';
    const merchant = d.merchant ? (d.merchant + (d.merchantCost ? '  (' + d.merchantCost + ')' : '')) : '';
    if (track) {
      const unlock = d.merchant ? 'Merchant' : '';
      const owned = '=COUNTIF(I' + r + ':L' + r + ',TRUE)';
      const who = '=TEXTJOIN(", ",TRUE,IF(I' + r + ',I$1,""),IF(J' + r + ',J$1,""),IF(K' + r + ',K$1,""),IF(L' + r + ',L$1,""))';
      return [icon, d.name, d.type, cap_(d.rarity), unlock, d.station, d.ingredients, merchant,
              false, false, false, false, owned, who, d.effect];
    }
    return [icon, d.name, d.type, cap_(d.rarity), d.station, d.ingredients, merchant, d.effect];
  });
  sh.getRange(2, 1, nRows, nCols).setValues(rows);

  // widths
  const W = track
    ? { 1: 46, 2: 230, 3: 120, 4: 95, 5: 90, 6: 185, 7: 290, 8: 200, 13: 66, 14: 150, 15: 360 }
    : { 1: 46, 2: 230, 3: 120, 4: 95, 5: 185, 6: 300, 7: 200, 8: 380 };
  Object.keys(W).forEach(function (c) { sh.setColumnWidth(Number(c), W[c]); });
  if (track) for (let j = 0; j < PLAYERS.length; j++) sh.setColumnWidth(T_PLAYER0 + j, 62);

  // alignment / wrap / heights
  sh.setRowHeights(2, nRows, 40);
  sh.getRange(2, 1, nRows, nCols).setVerticalAlignment('middle');
  sh.getRange(2, 1, nRows, 1).setHorizontalAlignment('center');
  sh.getRange(2, RARITY_COL, nRows, 1).setHorizontalAlignment('center').setFontWeight('bold');
  sh.getRange(2, 6, nRows, 1).setWrap(true);                 // station/ingredients-ish
  sh.getRange(2, merchantCol, nRows, 1).setWrap(true);
  sh.getRange(2, nCols, nRows, 1).setWrap(true).setFontColor('#666666').setFontSize(9); // effect
  sh.getRange(2, track ? 7 : 6, nRows, 1).setWrap(true);     // ingredients
  if (track) {
    sh.getRange(2, 5, nRows, 1).setHorizontalAlignment('center');                       // unlock
    sh.getRange(2, T_PLAYER0, nRows, PLAYERS.length).setHorizontalAlignment('center').insertCheckboxes();
    sh.getRange(2, 13, nRows, 1).setHorizontalAlignment('center').setFontWeight('bold'); // owned
  }

  sh.setFrozenRows(1);
  sh.setFrozenColumns(2);
  sh.getRange(2, 1, nRows, nCols).applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, false, false);

  // conditional formatting
  const rules = [];
  Object.keys(RARITY).forEach(function (k) {
    rules.push(SpreadsheetApp.newConditionalFormatRule()
      .whenTextEqualTo(k).setBackground(RARITY[k][0]).setFontColor(RARITY[k][1])
      .setRanges([sh.getRange(2, RARITY_COL, nRows, 1)]).build());
  });
  if (track) {
    for (let j = 0; j < PLAYERS.length; j++) {
      const c = colLetter_(T_PLAYER0 + j);
      rules.push(SpreadsheetApp.newConditionalFormatRule()
        .whenFormulaSatisfied('=' + c + '2=TRUE').setBackground('#b7e1cd')
        .setRanges([sh.getRange(2, T_PLAYER0 + j, nRows, 1)]).build());
    }
    rules.push(SpreadsheetApp.newConditionalFormatRule()
      .setGradientMinpointWithValue('#f4c7c3', SpreadsheetApp.InterpolationType.NUMBER, '0')
      .setGradientMidpointWithValue('#fff2cc', SpreadsheetApp.InterpolationType.NUMBER, '2')
      .setGradientMaxpointWithValue('#b7e1cd', SpreadsheetApp.InterpolationType.NUMBER, '4')
      .setRanges([sh.getRange(2, 13, nRows, 1)]).build());
  }
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenCellNotEmpty().setBackground('#fff2cc')
    .setRanges([sh.getRange(2, merchantCol, nRows, 1)]).build());
  sh.setConditionalFormatRules(rules);

  sh.getRange(1, 1, nRows + 1, nCols).createFilter();
  if (keep) restoreTicks_(sh, keep);
}

/* ---- preserve crew checkmarks across a rebuild (matched by recipe name) ---- */
function snapshotTicks_(ss, name) {
  const sh = ss.getSheetByName(name);
  if (!sh) return null;
  const n = sh.getLastRow() - 1;
  if (n < 1) return null;
  const hdr = sh.getRange(1, T_PLAYER0, 1, PLAYERS.length).getValues()[0];
  if (hdr.join(',') !== PLAYERS.join(',')) return null;         // unexpected layout -> leave it alone
  const names = sh.getRange(2, 2, n, 1).getValues();
  const checks = sh.getRange(2, T_PLAYER0, n, PLAYERS.length).getValues();
  const map = {};
  for (let i = 0; i < n; i++) if (names[i][0]) map[names[i][0]] = checks[i];
  return map;
}

function restoreTicks_(sh, map) {
  const n = sh.getLastRow() - 1;
  if (n < 1) return;
  const names = sh.getRange(2, 2, n, 1).getValues();
  const out = []; let any = false;
  for (let i = 0; i < n; i++) {
    const prev = map[names[i][0]];
    if (prev) { out.push(prev); any = true; } else { out.push(new Array(PLAYERS.length).fill(false)); }
  }
  if (any) sh.getRange(2, T_PLAYER0, n, PLAYERS.length).setValues(out);
}

/* ---- Dashboard ---- */
function buildDashboard_(ss) {
  const sh = freshSheet_(ss, 'Dashboard');
  sh.setHiddenGridlines(true);
  const trackTabs = TABS.filter(function (t) { return t.track; });
  const refTabs = TABS.filter(function (t) { return !t.track; });
  function tabCount(t) { return DATA.filter(function (d) { return matchTab_(d, t); }).length; }
  const totalTrack = trackTabs.reduce(function (s, t) { return s + tabCount(t); }, 0);

  sh.getRange('B2').setValue('🧭  Windrose Recipe Tracker')
    .setFontSize(22).setFontWeight('bold').setFontColor(HEADER_BG);
  sh.getRange('B3').setValue('One tab per category. Tick the gear tabs (Armor · Jewelry · Weapons · Ship Gear); '
    + 'Consumables / Resources / Misc are reference only.').setFontColor('#666666');

  sh.getRange('B5:D5').setValues([['Crew member', 'Recipes known', '% complete']])
    .setFontWeight('bold').setBackground(HEADER_BG).setFontColor('#ffffff');
  PLAYERS.forEach(function (p, i) {
    const r = 6 + i, col = colLetter_(T_PLAYER0 + i);
    const known = trackTabs.map(function (t) { return "COUNTIF('" + t.name + "'!" + col + ":" + col + ",TRUE)"; }).join('+');
    sh.getRange(r, 2).setValue(p).setFontWeight('bold');
    sh.getRange(r, 3).setFormula('=' + known);
    sh.getRange(r, 4).setFormula('=IFERROR(C' + r + '/' + totalTrack + ',0)').setNumberFormat('0.0%');
  });
  const tr = 6 + PLAYERS.length;
  sh.getRange(tr, 2).setValue('Trackable recipes').setFontWeight('bold');
  sh.getRange(tr, 3).setValue(totalTrack).setFontWeight('bold');

  // trackable tab × crew
  const mTop = tr + 2;
  sh.getRange(mTop, 2, 1, 2 + PLAYERS.length).setValues([['Gear tab', 'Total'].concat(PLAYERS)])
    .setFontWeight('bold').setBackground(HEADER_BG).setFontColor('#ffffff');
  trackTabs.forEach(function (t, i) {
    const r = mTop + 1 + i;
    sh.getRange(r, 2).setValue(t.name).setFontWeight('bold');
    sh.getRange(r, 3).setValue(tabCount(t));
    PLAYERS.forEach(function (p, j) {
      const col = colLetter_(T_PLAYER0 + j);
      sh.getRange(r, 4 + j).setFormula("=COUNTIF('" + t.name + "'!" + col + ":" + col + ",TRUE)");
    });
  });

  // reference tabs (counts only)
  const rTop = mTop + trackTabs.length + 2;
  sh.getRange(rTop, 2, 1, 2).setValues([['Reference tab', 'Items']])
    .setFontWeight('bold').setBackground('#666666').setFontColor('#ffffff');
  refTabs.forEach(function (t, i) {
    sh.getRange(rTop + 1 + i, 2).setValue(t.name);
    sh.getRange(rTop + 1 + i, 3).setValue(tabCount(t));
  });

  // rarity legend
  const lTop = rTop + refTabs.length + 2;
  sh.getRange(lTop, 2).setValue('Rarity legend').setFontWeight('bold');
  Object.keys(RARITY).forEach(function (k, i) {
    sh.getRange(lTop + 1 + i, 2).setValue(k)
      .setBackground(RARITY[k][0]).setFontColor(RARITY[k][1])
      .setFontWeight('bold').setHorizontalAlignment('center');
  });

  sh.setColumnWidth(1, 30); sh.setColumnWidth(2, 165); sh.setColumnWidth(3, 130);
  for (let j = 0; j < PLAYERS.length + 1; j++) sh.setColumnWidth(4 + j, 82);
  sh.setTabColor('#38761d');
}

/* ---- How to use ---- */
function buildHowTo_(ss) {
  const sh = freshSheet_(ss, 'How to use');
  sh.setHiddenGridlines(true);
  const SECTIONS = ['THE TABS', 'WHY ONLY GEAR IS TRACKED', 'DAY TO DAY', 'FILTERS & SHARING'];
  const lines = [
    ['🧭  Windrose Recipe Tracker — how it works'],
    [''],
    ['THE TABS'],
    ['Each category has its own coloured tab along the bottom. Click the one you want.'],
    ['•  Trackable gear — Armor, Jewelry, Weapons, Ship Gear — has a checkbox per crew member.'],
    ['•  Reference only — Consumables, Resources, Misc — no checkboxes, just a browseable catalogue.'],
    [''],
    ['WHY ONLY GEAR IS TRACKED'],
    ['Food & potions auto-unlock the moment you pick up their ingredients, so everyone gets them —'],
    ['nothing to coordinate. Gear (armour, weapons, jewellery, ship cannons) is unlocked deliberately'],
    ['and can be copied to a crewmate, so those are the tabs worth ticking.'],
    [''],
    ['DAY TO DAY'],
    ['•  On a gear tab, tick your own column (Eze / Cowy / Nick / Cheese) when you learn a recipe.'],
    ['•  "Who has it" shows who can hand you a copy. "Owned" = how many of you have it.'],
    ['•  "Buy from Merchant" (yellow) means a vendor sells it — only buy if no crewmate has it.'],
    ['•  The Dashboard tab totals everyone across all the gear tabs.'],
    [''],
    ['FILTERS & SHARING'],
    ['•  Use the ▾ arrows on any header to filter by Type, Rarity or Station, or by who has a recipe.'],
    ['•  Click Share (top-right) and add the crew as Editors. The Google Sheets phone app works great.'],
    [''],
    ['Icons & data: community "WindrosePlus" catalogue (840 items). Duplicate names merged.'],
  ];
  sh.getRange(2, 2, lines.length, 1).setValues(lines);
  sh.getRange(2, 2).setFontSize(18).setFontWeight('bold').setFontColor(HEADER_BG);
  for (let i = 0; i < lines.length; i++) {
    if (SECTIONS.indexOf(lines[i][0]) >= 0) {
      sh.getRange(2 + i, 2).setFontWeight('bold').setFontColor(HEADER_BG).setFontSize(12);
    }
  }
  sh.setColumnWidth(1, 30); sh.setColumnWidth(2, 780);
  sh.setTabColor('#b45f06');
}
