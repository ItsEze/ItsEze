/* ------------------------------------------------------------------ */
function onOpen() {
  SpreadsheetApp.getUi().createMenu('🧭 Windrose')
    .addItem('Build / Rebuild tracker', 'buildWindroseTracker')
    .addToUi();
}

function buildWindroseTracker() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  buildRecipes_(freshSheet_(ss, 'Recipes'));
  buildDashboard_(freshSheet_(ss, 'Dashboard'));
  buildHowTo_(freshSheet_(ss, 'How to use'));
  orderSheets_(ss, ['Dashboard', 'Recipes', 'How to use']);
  removeDefault_(ss);
  ss.setActiveSheet(ss.getSheetByName('Recipes'));
  ss.toast(DATA.length + ' recipes loaded — tick the boxes & Share with the crew!',
           '🧭 Windrose ready', 6);
}

/* ---- helpers ---- */
function colLetter_(n) {
  let s = '';
  while (n > 0) { const m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = (n - m - 1) / 26; }
  return s;
}
function cap_(s) { s = String(s || ''); return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }

function freshSheet_(ss, name) {
  let sh = ss.getSheetByName(name);
  if (sh) {
    const f = sh.getFilter(); if (f) f.remove();
    sh.getBandings().forEach(function (b) { b.remove(); });
    sh.clearConditionalFormatRules();
    sh.clear();
    if (sh.getMaxRows() > 1) sh.setRowHeights(1, sh.getMaxRows(), 21);
  } else {
    sh = ss.insertSheet(name);
  }
  return sh;
}

function orderSheets_(ss, order) {
  order.forEach(function (name, i) {
    const s = ss.getSheetByName(name);
    if (s) { ss.setActiveSheet(s); ss.moveActiveSheet(i + 1); }
  });
}

function removeDefault_(ss) {
  ['Sheet1', 'Sheet 1'].forEach(function (n) {
    const s = ss.getSheetByName(n);
    if (s && s.getLastRow() === 0 && ss.getSheets().length > 1) {
      try { ss.deleteSheet(s); } catch (e) {}
    }
  });
}

/* ---- Recipes tab ---- */
function buildRecipes_(sh) {
  const nCols = HEADERS.length, nRows = DATA.length;

  sh.getRange(1, 1, 1, nCols).setValues([HEADERS])
    .setFontWeight('bold').setFontColor('#ffffff').setBackground(HEADER_BG)
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
  sh.setRowHeight(1, 36);

  const a = colLetter_(FIRST_PLAYER_COL);
  const z = colLetter_(FIRST_PLAYER_COL + PLAYERS.length - 1);
  const rows = [];
  for (let i = 0; i < nRows; i++) {
    const d = DATA[i], r = i + 2;
    const icon = d.imageUrl ? '=IMAGE("' + d.imageUrl + '",4,36,36)' : '';
    const merchant = d.merchant ? (d.merchant + (d.merchantCost ? '  (' + d.merchantCost + ')' : '')) : '';
    const unlock = d.merchant ? 'Merchant' : '';
    const owned = '=COUNTIF(' + a + r + ':' + z + r + ',TRUE)';
    const who = '=TEXTJOIN(", ",TRUE,' + PLAYERS.map(function (p, j) {
      const c = colLetter_(FIRST_PLAYER_COL + j); return 'IF(' + c + r + ',' + c + '$1,"")';
    }).join(',') + ')';
    rows.push([icon, d.name, d.category, d.type, cap_(d.rarity), unlock, d.station,
               d.ingredients, merchant, false, false, false, false, owned, who, d.effect]);
  }
  sh.getRange(2, 1, nRows, nCols).setValues(rows);
  sh.getRange(2, FIRST_PLAYER_COL, nRows, PLAYERS.length).insertCheckboxes();

  // column widths
  const W = { 1: 46, 2: 230, 3: 115, 4: 125, 5: 95, 6: 95, 7: 195, 8: 300, 9: 215, 14: 70, 15: 165, 16: 380 };
  Object.keys(W).forEach(function (c) { sh.setColumnWidth(Number(c), W[c]); });
  for (let j = 0; j < PLAYERS.length; j++) sh.setColumnWidth(FIRST_PLAYER_COL + j, 62);

  // alignment / wrap / heights
  sh.setRowHeights(2, nRows, 40);
  const body = sh.getRange(2, 1, nRows, nCols);
  body.setVerticalAlignment('middle');
  sh.getRange(2, 1, nRows, 1).setHorizontalAlignment('center');                                   // icon
  sh.getRange(2, RARITY_COL, nRows, 1).setHorizontalAlignment('center').setFontWeight('bold');     // rarity
  sh.getRange(2, 6, nRows, 1).setHorizontalAlignment('center');                                    // unlock
  sh.getRange(2, FIRST_PLAYER_COL, nRows, PLAYERS.length).setHorizontalAlignment('center');         // checks
  sh.getRange(2, OWNED_COL, nRows, 1).setHorizontalAlignment('center').setFontWeight('bold');       // owned
  sh.getRange(2, 8, nRows, 1).setWrap(true);                                                        // ingredients
  sh.getRange(2, 9, nRows, 1).setWrap(true);                                                        // merchant
  sh.getRange(2, 16, nRows, 1).setWrap(true).setFontColor('#666666').setFontSize(9);                // effect

  sh.setFrozenRows(1);
  sh.setFrozenColumns(2);
  sh.getRange(2, 1, nRows, nCols).applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, false, false);

  // conditional formatting
  const rules = [];
  Object.keys(RARITY).forEach(function (k) {
    rules.push(SpreadsheetApp.newConditionalFormatRule()
      .whenTextEqualTo(k).setBackground(RARITY[k][0]).setFontColor(RARITY[k][1])
      .setRanges([sh.getRange(2, RARITY_COL, nRows, 1)]).build());
  });
  for (let j = 0; j < PLAYERS.length; j++) {
    const c = colLetter_(FIRST_PLAYER_COL + j);
    rules.push(SpreadsheetApp.newConditionalFormatRule()
      .whenFormulaSatisfied('=' + c + '2=TRUE').setBackground('#b7e1cd')
      .setRanges([sh.getRange(2, FIRST_PLAYER_COL + j, nRows, 1)]).build());
  }
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .setGradientMinpointWithValue('#f4c7c3', SpreadsheetApp.InterpolationType.NUMBER, '0')
    .setGradientMidpointWithValue('#fff2cc', SpreadsheetApp.InterpolationType.NUMBER, '2')
    .setGradientMaxpointWithValue('#b7e1cd', SpreadsheetApp.InterpolationType.NUMBER, '4')
    .setRanges([sh.getRange(2, OWNED_COL, nRows, 1)]).build());
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenCellNotEmpty().setBackground('#fff2cc')
    .setRanges([sh.getRange(2, 9, nRows, 1)]).build());
  sh.setConditionalFormatRules(rules);

  sh.getRange(1, 1, nRows + 1, nCols).createFilter();
  sh.setTabColor('#0b5394');
}

/* ---- Dashboard tab ---- */
function buildDashboard_(sh) {
  sh.setHiddenGridlines(true);
  const total = DATA.length;
  const pcol = PLAYERS.map(function (p, j) { return colLetter_(FIRST_PLAYER_COL + j); });
  const typeL = colLetter_(TYPE_COL), ownedL = colLetter_(OWNED_COL);

  sh.getRange('B2').setValue('🧭  Windrose Recipe Tracker')
    .setFontSize(22).setFontWeight('bold').setFontColor(HEADER_BG);
  sh.getRange('B3').setValue('Live overview — updates as the crew ticks recipes on the Recipes tab. '
    + total + ' shareable gear recipes: armour, weapons & jewellery.').setFontColor('#666666');

  // crew progress
  sh.getRange('B5:D5').setValues([['Crew member', 'Recipes known', '% complete']])
    .setFontWeight('bold').setBackground(HEADER_BG).setFontColor('#ffffff');
  PLAYERS.forEach(function (p, i) {
    const r = 6 + i;
    sh.getRange(r, 2).setValue(p).setFontWeight('bold');
    sh.getRange(r, 3).setFormula('=COUNTIF(Recipes!' + pcol[i] + ':' + pcol[i] + ',TRUE)');
    sh.getRange(r, 4).setFormula('=IFERROR(C' + r + '/' + total + ',0)').setNumberFormat('0.0%');
  });
  const tr = 6 + PLAYERS.length;
  sh.getRange(tr, 2).setValue('Total recipes').setFontWeight('bold');
  sh.getRange(tr, 3).setValue(total).setFontWeight('bold');
  sh.getRange(tr + 1, 2).setValue('Nobody has yet').setFontColor('#990000').setFontWeight('bold');
  sh.getRange(tr + 1, 3).setFormula('=COUNTIF(Recipes!' + ownedL + ':' + ownedL + ',0)')
    .setFontColor('#990000').setFontWeight('bold');

  // type × crew matrix
  const mTop = tr + 3;
  sh.getRange(mTop, 2, 1, 2 + PLAYERS.length)
    .setValues([['Type', 'Total'].concat(PLAYERS)])
    .setFontWeight('bold').setBackground(HEADER_BG).setFontColor('#ffffff');
  TYPES.forEach(function (ty, i) {
    const r = mTop + 1 + i;
    sh.getRange(r, 2).setValue(ty).setFontWeight('bold');
    sh.getRange(r, 3).setFormula('=COUNTIF(Recipes!' + typeL + ':' + typeL + ',"' + ty + '")');
    PLAYERS.forEach(function (p, j) {
      sh.getRange(r, 4 + j).setFormula('=COUNTIFS(Recipes!' + typeL + ':' + typeL + ',"' + ty
        + '",Recipes!' + pcol[j] + ':' + pcol[j] + ',TRUE)');
    });
  });

  // rarity legend
  const lTop = mTop + TYPES.length + 3;
  sh.getRange(lTop, 2).setValue('Rarity legend').setFontWeight('bold');
  Object.keys(RARITY).forEach(function (k, i) {
    sh.getRange(lTop + 1 + i, 2).setValue(k)
      .setBackground(RARITY[k][0]).setFontColor(RARITY[k][1])
      .setFontWeight('bold').setHorizontalAlignment('center');
  });

  sh.setColumnWidth(1, 30); sh.setColumnWidth(2, 175); sh.setColumnWidth(3, 135);
  for (let j = 0; j < PLAYERS.length + 1; j++) sh.setColumnWidth(4 + j, 82);
  sh.setTabColor('#38761d');
}

/* ---- How to use tab ---- */
function buildHowTo_(sh) {
  sh.setHiddenGridlines(true);
  const SECTIONS = ['THE GOAL', 'DAY TO DAY', 'FILTERS  (the ▾ arrows on the header row)',
                    'SHARING WITH THE CREW', 'ADDING & EDITING'];
  const lines = [
    ['🧭  Windrose Recipe Tracker — how it works'],
    [''],
    ['THE GOAL'],
    ['Track which recipes each of you (Eze · Cowy · Nick · Cheese) has unlocked, so nobody'],
    ['burns coin or a single-use Recipe Paper on something a crewmate can already copy to you.'],
    ['Scope on purpose: only shareable gear — armour, weapons & jewellery. Food & potions'],
    ['auto-unlock when you grab their ingredients, and ships cannot be handed over, so both are out.'],
    [''],
    ['DAY TO DAY'],
    ['•  Open the Recipes tab. Find a recipe with the column filters ▾ or Ctrl/Cmd+F.'],
    ['•  When you learn a recipe, tick your own column (Eze / Cowy / Nick / Cheese).'],
    ['•  "Who has it" shows who can hand you a copy. "Owned" = how many of you have it.'],
    ['•  "Buy from Merchant" (yellow) means a vendor sells it — only buy if no crewmate has it.'],
    [''],
    ['FILTERS  (the ▾ arrows on the header row)'],
    ['•  Type  → Armour, Rings, Necklaces, Backpacks, Melee, Range, Tools or Ammo.'],
    ['•  Rarity / Station → e.g. just Legendary, or just the "Armor and Clothing Workshop".'],
    ['•  Tick a crew column filter to TRUE / FALSE to see exactly what they have or still need.'],
    ['•  Tip: filter Owned = 0 to find recipes nobody has unlocked yet.'],
    [''],
    ['SHARING WITH THE CREW'],
    ['•  Click Share (top-right) and add Eze, Cowy, Nick & Cheese as Editors — everyone edits live.'],
    ['•  On phones: install the Google Sheets app and open this file. Checkboxes work great there.'],
    [''],
    ['ADDING & EDITING'],
    ['•  Add your own rows at the bottom — fill the columns and tick boxes as normal.'],
    ['•  For a picture, put  =IMAGE("https://…")  in the Icon cell.'],
    ['•  Re-run  🧭 Windrose ▸ Build / Rebuild tracker  any time; your ticks stay put.'],
    [''],
    ['Icons & recipe data: community "WindrosePlus" catalogue (840 items), filtered to 167 gear recipes.'],
  ];
  sh.getRange(2, 2, lines.length, 1).setValues(lines);
  sh.getRange(2, 2).setFontSize(18).setFontWeight('bold').setFontColor(HEADER_BG);
  for (let i = 0; i < lines.length; i++) {
    if (SECTIONS.indexOf(lines[i][0]) >= 0) {
      sh.getRange(2 + i, 2).setFontWeight('bold').setFontColor(HEADER_BG).setFontSize(12);
    }
  }
  sh.setColumnWidth(1, 30); sh.setColumnWidth(2, 760);
  sh.setTabColor('#b45f06');
}
